{
  "rules": {
    ".read": false,
    ".write": false,
    "meetings": {
      "$meeting": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('creator').val() === auth.uid",
        ".validate": "newData.hasChildren(['title', 'dates', 'start', 'end', 'step', 'ifNeeded', 'creator'])",
        "creator": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "dates": {
          ".validate": "newData.hasChildren(['0', '1', '2', '3', '4', '5', '6'])",
          "$index": { ".validate": "$index.matches(/^[0-6]$/) && newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
        },
        "start": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
        "end": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('start').val() && newData.val() <= 1440" },
        "step": { ".validate": "newData.val() === 15 || newData.val() === 30 || newData.val() === 45 || newData.val() === 60" },
        "ifNeeded": { ".validate": "newData.isBoolean()" },
        "people": {
          "$user": {
            ".write": "auth != null && auth.uid === $user && data.parent().parent().exists()",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "slots": {
              "$slot": { ".validate": "newData.val() === true && $slot.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}:[0-9]{1,4}$/)" }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
